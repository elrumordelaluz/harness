{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ cd \"$CLAUDE_PROJECT_DIR\" && \"$CLAUDE_PROJECT_DIR\"/.harness/bootstrap.sh; } 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.harness/bin/ensure-hooks.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm format:check*)",
      "Bash(pnpm build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Bash(gh label *)",
      "Bash(gh run *)",
      "Bash(.harness/bin/tier.sh*)",
      "Bash(.harness/bin/test-weakening.sh*)",
      "Bash(.harness/bin/commitlint.sh*)",
      "Bash(.harness/bin/prose.sh*)",
      "Bash(.harness/bin/judge.sh*)",
      "Bash(.harness/bin/board.sh*)"
    ]
  }
}
