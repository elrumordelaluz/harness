#!/usr/bin/env bash
# Runs on every commit, for humans and agents alike. Refuses commits on main:
# a private repo on GitHub Free has no ruleset, so this hook and pre-push are
# what protect the branch. HARNESS_ALLOW_MAIN=1 overrides, for a human who
# knows why. Then, under 30 seconds: format check on the staged files, the
# prose gate on the staged lines, typecheck. The full suite runs in CI.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# The pin before any other check: .harness/bin/.sha, which the bootstrap
# writes, must be the pin.sha of .harness/stamp.json, or this clone commits
# under rules the others no longer have. HARNESS_ALLOW_MAIN does not open it.
# The harness repo has no pin, and the rule of the bootstrap spares it: no
# stamp, the template tracked, .harness/bootstrap.sh a tracked link to it and
# .harness/bin tracked. The same lines sit in the three hooks.
t=skills/harness-init/templates/bootstrap.sh
if [ -f .harness/stamp.json ] || [ -z "$(git ls-files -- .harness/bin)" ] ||
  [ -z "$(git ls-files -- "$t")" ] ||
  [ "$(git ls-files -s -- .harness/bootstrap.sh | cut -c1-6)" != 120000 ] ||
  [ "$(readlink .harness/bootstrap.sh)" != "../$t" ]; then
  pin="$(jq -r '.pin.sha // empty' .harness/stamp.json 2>/dev/null || true)"
  if [ -z "$pin" ] || [ "$(cat .harness/bin/.sha 2>/dev/null || true)" != "$pin" ]; then
    echo "harness: .harness/bin is not at the pin.sha of .harness/stamp.json, run .harness/bootstrap.sh" >&2
    exit 1
  fi
fi
branch="$(git symbolic-ref --short -q HEAD || true)"
if [ "${HARNESS_ALLOW_MAIN:-}" != 1 ] && { [ "$branch" = main ] || [ "$branch" = master ]; }; then
  refused="harness: no commits on $branch. Switch to slice/S<NN>-<slug> or harness/<stage>; intent/<slug> and spec/<slug> where the policy block of .harness/AGENTS.md says docs_mode pr."
  # The one exception: with `"docs_mode": "main"` in the policy block a commit
  # made only of documents goes through, every staged file, deletions
  # included, under a path of human_gate_paths or of docs_extra_paths. The
  # rules are the ones at HEAD, which is the base of a commit on main: the
  # commit could rewrite .harness/AGENTS.md, and then the rules it is held to
  # would be its own. A commit that touches it is not a document anyway, so
  # the copy at HEAD is the one that counts. The root AGENTS.md is the
  # project's and holds no block: one left there is not read.
  if [ ! -f .harness/bin/policy-lines.sh ]; then echo "$refused" >&2; exit 1; fi
  . .harness/bin/policy-lines.sh
  agents="$(git show HEAD:.harness/AGENTS.md 2>/dev/null || true)"
  # No fence, a fence jq refuses, a key missing, a version this harness has
  # never read: four faults, and main stays closed on all four instead of
  # falling back to pr, which refused for a reason that was not the true one.
  why="$(policy_why "$agents")"
  if [ -n "$why" ]; then echo "$refused .harness/AGENTS.md at HEAD: $why" >&2; exit 1; fi
  if [ "$(docs_mode "$agents")" != main ]; then echo "$refused" >&2; exit 1; fi
  files="$(git -c core.quotePath=false diff --cached --no-renames --name-only)"
  if [ -z "$files" ]; then
    echo "$refused Nothing is staged, and an empty commit is not a document." >&2
    exit 1
  fi
  outside="$(docs_outside "$agents" "$files")"
  if [ -n "$outside" ]; then
    echo "$refused Only documents go on $branch (.harness/AGENTS.md, docs_mode), and $outside is not one." >&2
    exit 1
  fi
fi
# Symlinks are skipped: Prettier refuses a symlink named explicitly, and the
# target is checked on its own path when it changes.
staged="$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do [ -L "$f" ] || printf '%s\n' "$f"; done)"
[ -z "$staged" ] && exit 0
printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 pnpm exec prettier --check --ignore-unknown
.harness/bin/prose.sh --staged
pnpm typecheck
