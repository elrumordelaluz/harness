#!/usr/bin/env bash
# Refuses pushes to main: the local twin of the ruleset, for repos that cannot
# have one. Merges go through the PR (gh pr merge), which never runs this hook.
# HARNESS_ALLOW_MAIN=1 overrides.
# The one exception is the one pre-commit makes: with `"docs_mode": "main"`
# in the policy block a push whose commits touch only documents goes through.
# Every file any commit of the range touched counts, not the net diff, and
# the rules are read at main as the remote has it, the base of the push: a
# commit of the range could rewrite them, and it is not a document.
set -euo pipefail
[ "${HARNESS_ALLOW_MAIN:-}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)"
while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  target="${remote_ref#refs/heads/}"
  refused="harness: no direct push to $target. Open a PR."
  [ "$local_sha" = "$remote_sha" ] && continue
  # A deletion, a branch the remote does not have yet, a remote commit this
  # clone has never fetched, a history rewritten: none of them is a range of
  # documents on top of the remote main, so none of them is the exception.
  case "$local_sha" in *[!0]*) ;; *) echo "$refused" >&2; exit 1 ;; esac
  case "$remote_sha" in *[!0]*) ;; *) echo "$refused" >&2; exit 1 ;; esac
  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null ||
    ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "$refused And this push does not sit on top of $target as the remote has it." >&2
    exit 1
  fi
  if [ ! -f scripts/policy-lines.sh ]; then echo "$refused" >&2; exit 1; fi
  . scripts/policy-lines.sh
  agents="$(git show "$remote_sha:AGENTS.md" 2>/dev/null || true)"
  # The four faults pre-commit stops on, read at the same ref as the rules:
  # a block nobody can read keeps the branch closed and says which fault it is.
  why="$(policy_why "$agents")"
  if [ -n "$why" ]; then
    echo "$refused AGENTS.md at $target as the remote has it: $why" >&2
    exit 1
  fi
  if [ "$(docs_mode "$agents")" != main ]; then echo "$refused" >&2; exit 1; fi
  # -m: a merge commit shows what it brings against each parent, so nothing
  # enters main behind one. Sorted, so the file named is the same every time.
  files="$(git -c core.quotePath=false log --no-renames -m --format= --name-only "$remote_sha..$local_sha" | { grep . || true; } | LC_ALL=C sort -u)"
  if [ -z "$files" ]; then
    echo "$refused These commits change no file, and an empty commit is not a document." >&2
    exit 1
  fi
  outside="$(docs_outside "$agents" "$files")"
  if [ -n "$outside" ]; then
    echo "$refused Only documents go on $target (AGENTS.md, docs_mode), and $outside is not one." >&2
    exit 1
  fi
done
exit 0
