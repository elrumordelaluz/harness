{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "verdict",
  "type": "object",
  "required": [
    "tier",
    "judge",
    "verdict",
    "confidence",
    "criteria",
    "findings",
    "scope_ok",
    "needs_human",
    "reason"
  ],
  "properties": {
    "pr": {
      "type": "integer",
      "description": "Filled by policy.sh, never by the judge: /judge runs before the PR exists and cannot know the number."
    },
    "slice": { "type": ["string", "null"] },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Filled by judge.sh when it stores the verdict: the commit the diff was read from, so a verdict cannot answer for a PR opened against another base."
    },
    "answers": {
      "type": "array",
      "description": "Filled by judge.sh answer, never by the judge: the commit that closes a finding, the id being F1 for the first finding of the list. The judge runs once per PR and the session answers what it fixes; judge.sh check drops what a judge writes here.",
      "items": {
        "type": "object",
        "required": ["id", "sha"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[1-9][0-9]*$" },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "judge": {
      "type": "object",
      "required": ["role", "model", "ts"],
      "properties": {
        "role": { "enum": ["correctness", "security"] },
        "model": { "type": "string" },
        "ts": { "type": "string" },
        "where": {
          "enum": ["local"],
          "description": "Filled by policy.sh, never by the judge: local, because /judge before the PR is the only judge of the chain and no workflow calls a model."
        }
      }
    },
    "verdict": { "enum": ["approve", "request-changes", "escalate"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ok"],
        "properties": {
          "id": { "type": "string" },
          "covered_by": { "type": ["string", "null"] },
          "ok": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file", "claim", "evidence"],
        "properties": {
          "severity": { "enum": ["high", "medium", "low"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "claim": { "type": "string" },
          "evidence": { "type": "string" },
          "by": {
            "enum": ["judge", "human"],
            "description": "Filled by judge.sh finding, never by the judge: `human` marks what a human found reading the open PR, and absent means the judge found it. judge.sh check drops what a judge writes here, so the review log can tell the two apart."
          }
        }
      }
    },
    "scope_ok": { "type": "boolean" },
    "needs_human": { "type": "boolean" },
    "reason": {
      "type": "string",
      "maxLength": 240,
      "description": "One sentence: why this verdict. Not what was checked, not what passed."
    },
    "human_reason": {
      "type": "string",
      "maxLength": 240,
      "description": "Only with needs_human: the one decision the human must take, as a question or an instruction, with the options when there are two."
    },
    "cost": {
      "type": "object",
      "properties": {
        "turns": { "type": ["integer", "null"] },
        "duration_ms": { "type": ["integer", "null"] },
        "cost_usd": { "type": ["number", "null"] },
        "input_tokens": { "type": ["integer", "null"] },
        "cache_creation_input_tokens": { "type": ["integer", "null"] },
        "cache_read_input_tokens": { "type": ["integer", "null"] },
        "output_tokens": { "type": ["integer", "null"] }
      }
    },
    "outcome": {
      "type": "object",
      "properties": {
        "decided_by": { "enum": ["policy", "human"] },
        "action": { "enum": ["merged", "changes", "closed"] },
        "ts": { "type": "string" }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "agree": { "type": ["boolean", "null"] },
        "missed_issue": { "type": ["boolean", "null"] },
        "useless_escalation": { "type": ["boolean", "null"] }
      }
    }
  }
}
